[Unit]
Description=Telegram bridge to Pi
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi
EnvironmentFile=/home/pi/.pi_telegram
# login shell so ~/.profile puts Node and the pi CLI on PATH
ExecStart=/bin/bash -lc "exec python3 -u /home/pi/pi_telegram.py"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
